# Configurações do Robô ERP ADMSIS (LigIA)
ERP_USER=seu_usuario_aqui
ERP_PASS=sua_senha_aqui
ERP_URL=https://erp.admsis.com/

# Impressora de destino (se vazio, usa a impressora padrão do Windows)
PRINTER_NAME=

# Intervalo entre verificações (em segundos) - 300s = 5 minutos
POLL_INTERVAL_SECONDS=300

# Período de busca de pedidos (auto = ontem até hoje; na segunda-feira inclui sexta-feira; ou número fixo de dias, ex: 1, 2, 3)
DIAS_RETROATIVOS=auto

# Executar navegador em segundo plano (true ou false)
HEADLESS=true

# Modo simulação (true = só baixa os PDFs, false = envia para impressora física)
DRY_RUN=false
